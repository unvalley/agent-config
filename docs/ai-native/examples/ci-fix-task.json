{
  "$schema": "../task-contract.schema.json",
  "schema_version": 1,
  "task_id": "ci-fix-agent-config-20260724-001",
  "kind": "ci-fix",
  "objective": "Diagnose the failed GitHub Actions check, apply the smallest causal fix, and prepare a verified draft pull request.",
  "source": {
    "type": "github-check",
    "repository": "unvalley/agent-config",
    "ref": "refs/heads/main",
    "url": "https://github.com/unvalley/agent-config/actions",
    "details": {
      "check_name": "test",
      "failed_sha": "0123456789abcdef0123456789abcdef01234567"
    }
  },
  "scope": {
    "include": [
      "**"
    ],
    "exclude": [
      ".git/**",
      "target/**"
    ]
  },
  "risk": {
    "level": "yellow",
    "reasons": [
      "The task may modify source code.",
      "The task writes a draft pull request to GitHub."
    ]
  },
  "permissions": {
    "workspace": "write",
    "network": "read",
    "external_write": "draft-pr"
  },
  "verification": {
    "checks": [
      {
        "name": "format",
        "command": "cargo fmt --check",
        "timeout_seconds": 120
      },
      {
        "name": "test",
        "command": "cargo test",
        "timeout_seconds": 900
      },
      {
        "name": "clippy",
        "command": "cargo clippy --all-targets -- -D warnings",
        "timeout_seconds": 900
      },
      {
        "name": "diff-check",
        "command": "git diff --check",
        "timeout_seconds": 60
      }
    ],
    "required_evidence": [
      "root-cause",
      "changed-files",
      "diff",
      "check-results",
      "verifier-report"
    ]
  },
  "delivery": {
    "mode": "draft-pr",
    "base_branch": "main"
  },
  "limits": {
    "max_attempts": 2,
    "max_minutes": 45,
    "max_changed_files": 10
  },
  "stop_conditions": {
    "success": [
      "The original failing check is explained by evidence.",
      "All declared verification checks pass.",
      "An independent verifier accepts the final diff."
    ],
    "stop": [
      "The root cause requires credentials or production access not declared in the task.",
      "The fix requires changing more files or taking more time than the declared limits.",
      "The task enters a red-risk area.",
      "The same verification failure repeats after the maximum attempts."
    ]
  }
}
